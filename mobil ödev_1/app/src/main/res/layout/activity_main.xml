<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@color/sayfa_arka_plan">

    <!-- 1. Grup: Yan yana fotoğraflar -->
    <LinearLayout
        android:id="@+id/resimGrubu"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/kart_arka_plan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/kayitGrubu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="spread">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:src="@drawable/resim1"
            android:scaleType="centerCrop"
            android:contentDescription="@string/fotograf" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/resim2"
            android:scaleType="centerCrop"
            android:contentDescription="@string/fotograf" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/resim3"
            android:scaleType="centerCrop"
            android:contentDescription="@string/fotograf" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:src="@drawable/resim4"
            android:scaleType="centerCrop"
            android:contentDescription="@string/fotograf" />

    </LinearLayout>

    <!-- 2. Grup: Kayıt formu -->
    <LinearLayout
        android:id="@+id/kayitGrubu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp"
        android:background="@color/kart_arka_plan"
        app:layout_constraintTop_toBottomOf="@id/resimGrubu"
        app:layout_constraintBottom_toTopOf="@id/girisGrubu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etAdSoyad"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/ad_soyad"
            android:inputType="textPersonName"
            android:textSize="14sp"
            android:textColor="@color/yazi_rengi"
            android:textColorHint="@color/ipucu_rengi" />

        <EditText
            android:id="@+id/etEposta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/eposta"
            android:inputType="textEmailAddress"
            android:textSize="14sp"
            android:textColor="@color/yazi_rengi"
            android:textColorHint="@color/ipucu_rengi" />

        <EditText
            android:id="@+id/etYas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/yas"
            android:inputType="number"
            android:textSize="14sp"
            android:textColor="@color/yazi_rengi"
            android:textColorHint="@color/ipucu_rengi" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnKayit"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:minHeight="0dp"
            android:background="@drawable/buton_arka_plan"
            android:text="@string/kayit_ol"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/buton_yazi"
            app:backgroundTint="@color/kayit_rengi" />

    </LinearLayout>

    <!-- 3. Grup: Giriş formu -->
    <LinearLayout
        android:id="@+id/girisGrubu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="2dp"
        android:background="@color/kart_arka_plan"
        app:layout_constraintTop_toBottomOf="@id/kayitGrubu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etKullaniciAdi"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/kullanici_adi"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="@color/yazi_rengi"
            android:textColorHint="@color/ipucu_rengi" />

        <EditText
            android:id="@+id/etSifre"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="@string/sifre"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:textColor="@color/yazi_rengi"
            android:textColorHint="@color/ipucu_rengi" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGiris"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:minHeight="0dp"
            android:background="@drawable/buton_arka_plan"
            android:text="@string/giris_yap"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/buton_yazi"
            app:backgroundTint="@color/giris_rengi" />

        <TextView
            android:id="@+id/tvSifremiUnuttum"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/sifremi_unuttum"
            android:textSize="12sp"
            android:textColor="@color/giris_rengi" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>